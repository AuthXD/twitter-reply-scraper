# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
# NOTE: the pipeline reads these from your shell ENVIRONMENT (os.environ), so also
# set them with `setx` (Windows) or `export` (macOS/Linux) — see the README.

# Required for the LLM intent gate (llm.enabled: true in config.yaml).
# Free key from https://build.nvidia.com  ->  account -> API keys.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional — only for the official X API v2 adapter (`--adapter api`).
# X_BEARER_TOKEN=your-x-api-v2-bearer-token
